"use client";

import { motion } from "framer-motion";
import { ArrowRight, CheckCircle } from "lucide-react";

export default function Hero() {
  const containerVariants = {
    hidden: { opacity: 0 },
    visible: {
      opacity: 1,
      transition: {
        staggerChildren: 0.2,
        delayChildren: 0.1,
      },
    },
  };

  const itemVariants = {
    hidden: { opacity: 0, y: 20 },
    visible: {
      opacity: 1,
      y: 0,
      transition: { duration: 0.8, ease: "easeOut" },
    },
  };

  return (
    <section className="relative overflow-hidden bg-gradient-to-br from-slate-950 via-blue-950 to-slate-950 px-4 pb-12 pt-24 text-white sm:px-6 sm:pb-16 sm:pt-32 md:pb-24 md:pt-40">
      
      {/* Animated background elements */}
      <div className="absolute top-0 left-1/4 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl animate-float" style={{ animationDelay: "0s" }} />
      <div className="absolute bottom-20 right-1/4 w-96 h-96 bg-orange-500/10 rounded-full blur-3xl animate-float" style={{ animationDelay: "2s" }} />
      <div className="absolute inset-0 bg-[linear-gradient(45deg,transparent_25%,transparent_75%,transparent)] bg-[length:60px_60px] opacity-5" />

      <div className="relative mx-auto grid max-w-7xl items-center gap-8 sm:gap-12 md:grid-cols-2">
        <motion.div
          variants={containerVariants}
          initial="hidden"
          animate="visible"
        >
          {/* Badge */}
          <motion.div
            variants={itemVariants}
            className="mb-6 inline-flex items-center gap-2 rounded-full bg-blue-500/20 border border-blue-400/30 px-4 py-2 backdrop-blur-sm"
          >
            <span className="w-2 h-2 bg-blue-400 rounded-full animate-pulse"></span>
            <span className="text-sm font-semibold text-blue-200">Expert Certifié • Depuis 2020</span>
          </motion.div>

          {/* Main heading */}
          <motion.h1
            variants={itemVariants}
            className="mb-4 text-3xl font-bold leading-tight sm:mb-6 sm:text-4xl md:text-6xl"
          >
            Transformez votre
            <span className="block bg-gradient-to-r from-blue-400 via-cyan-400 to-orange-400 bg-clip-text text-transparent"> Entreprise Digitalement</span>
          </motion.h1>

          {/* Description */}
          <motion.p
            variants={itemVariants}
            className="mb-8 max-w-xl text-lg text-slate-300 leading-relaxed"
          >
            Sphorix France accompagne les entreprises dans la gestion, l'organisation comptable et la transformation digitale avec des solutions modernes, sécurisées et adaptées à votre croissance.
          </motion.p>

          {/* Features list */}
          <motion.div variants={itemVariants} className="mb-8 space-y-3">
            {[
              { text: "Gestion Comptable" },
              { text: "Transformation Digitale" },
              { text: "Organisation Administrative" },
            ].map((feature, idx) => (
              <div key={idx} className="flex items-center gap-3 text-slate-300">
                <CheckCircle className="w-5 h-5 text-green-400" />
                <span>{feature.text}</span>
              </div>
            ))}
          </motion.div>

          {/* CTAs */}
          <motion.div variants={itemVariants} className="flex flex-wrap gap-4">
            
            <a
              href="#contact"
              className="group flex items-center gap-2 rounded-full bg-gradient-to-r from-blue-600 to-orange-500 px-6 py-3 font-semibold text-white transition-all duration-300 hover:shadow-lg hover:shadow-blue-500/30 hover:scale-105 sm:px-8"
            >
              Découvrir nos services
              <ArrowRight className="w-5 h-5 group-hover:translate-x-1 transition-transform" />
            </a>

            <a
              href="#contact"
              className="rounded-full border-2 border-white/30 px-6 py-3 font-semibold text-white transition-all duration-300 hover:bg-white/10 hover:border-white/50 backdrop-blur-sm sm:px-8"
            >
              Nous contacter
            </a>
          </motion.div>
        </motion.div>

        {/* Right side - Visual element */}
        <motion.div
          initial={{ opacity: 0, scale: 0.8 }}
          animate={{ opacity: 1, scale: 1 }}
          transition={{ duration: 1, delay: 0.3 }}
          className="hidden justify-center md:flex"
        >
          {/* Floating card effect */}
          <div className="relative group cursor-pointer">
            <div className="absolute inset-0 bg-gradient-to-r from-blue-500 to-orange-500 rounded-3xl blur-2xl group-hover:blur-3xl transition duration-300 opacity-50 group-hover:opacity-70"></div>
            <div className="relative bg-slate-900/80 backdrop-blur-xl rounded-3xl p-8 border border-white/10 space-y-4">
              <div className="text-3xl font-bold text-white">98%</div>
              <p className="text-slate-300 text-sm leading-relaxed">De nos clients satisfaits et en croissance permanente avec nos solutions digitales</p>
              <div className="flex gap-2 pt-4">
